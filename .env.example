# Development-only values for this repository's docker-compose.yaml.
# Do not use this file as a production configuration template.

# Go Cerebro dev auth.
APPLICATION_SECRET=docker-compose-dev-auth-secret-change-me
BASIC_AUTH_USER=admin
BASIC_AUTH_PWD=admin123
PROXY_AUTH_ENABLED=false

# Microsoft Entra ID direct login for the dev compose stack.
ENTRA_ID_ENABLED=false
ENTRA_ID_NAME="Microsoft Entra ID"
ENTRA_ID_TENANT_ID=
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=
ENTRA_ID_REDIRECT_URL=http://localhost:5173/auth/entraid/entra_id/callback

# GitHub OAuth dev proxy.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be exactly 16, 24 or 32 bytes.
OAUTH2_PROXY_COOKIE_SECRET=dev-cookie-secret-32-bytes-ok!!!
