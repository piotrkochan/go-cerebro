# Go 1.27.4; update with make bumpgo.
FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280

RUN apk add --no-cache curl
# air v1.67.4
RUN go install github.com/air-verse/air@9f19e52511f7bb697036e6ee2c12a212e742199d

WORKDIR /workspace/cerebro
COPY go.mod go.sum ./
RUN go mod download
COPY . .

EXPOSE 9000
CMD ["air"]
