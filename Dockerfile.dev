FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414

RUN apk add --no-cache curl
# air v1.67.4
RUN go install github.com/air-verse/air@9f19e52511f7bb697036e6ee2c12a212e742199d

WORKDIR /workspace/cerebro
COPY go.mod go.sum ./
RUN go mod download
COPY . .

EXPOSE 9000
CMD ["air"]
