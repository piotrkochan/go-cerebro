{
  "name": "cerebro",
  "version": "0.10.0",
  "description": "cerebro - elasticsearch admin",
  "type": "module",
  "scripts": {
    "api:openapi": "go run ./cmd/cerebro openapi -config conf/application.example.yaml > openapi/cerebro.json",
    "api:generate": "npm run api:openapi && openapi-ts -f openapi-ts.config.ts",
    "api:typecheck": "tsc -p tsconfig.api.json --noEmit",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:vite": "vite build",
    "build": "npm run api:generate && npm run typecheck && npm run build:vite",
    "preview": "vite preview",
    "test:go": "go test ./cmd/... ./internal/...",
    "test:e2e:elasticsearch": "bash scripts/e2e-elasticsearch-compat.sh",
    "test:e2e:floci-opensearch": "bash scripts/e2e-floci-opensearch-compat.sh",
    "test": "npm run typecheck && npm run api:typecheck && npm run test:go"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/piotrkochan/go-cerebro.git"
  },
  "author": "Leonardo Menezes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/piotrkochan/go-cerebro/issues"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "^4.3.1",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.7",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-store": "^0.11.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@lezer/highlight": "^1.2.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
